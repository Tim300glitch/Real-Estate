# ─── Auth ─────────────────────────────────────────────────────────────
# Secret used to sign session JWTs (server only). Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string
# Demo users are enabled when no database is configured (see src/server/auth/users.ts)
DEMO_MODE=true

# ─── Database (Supabase / Postgres + PostGIS) ────────────────────────
# When set, run db/migrations/*.sql against it. Server only.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Property data providers (server only, never exposed to browser) ─
# Which provider serves each capability. Values: demo | attom | rentcast | regrid | estated
PROPERTY_PROVIDER=demo
COMPS_PROVIDER=demo
PARCEL_PROVIDER=demo
ATTOM_API_KEY=
RENTCAST_API_KEY=
REGRID_API_TOKEN=

# ─── Skip trace (server only) ─────────────────────────────────────────
SKIPTRACE_PROVIDER=demo
SKIPTRACE_API_KEY=

# ─── Messaging / e-signature (server only) ───────────────────────────
SMS_PROVIDER=
EMAIL_PROVIDER=
ESIGN_PROVIDER=
ESIGN_API_KEY=

# ─── AI assistant (optional, server only) ────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ─── Maps (browser) ──────────────────────────────────────────────────
# MapLibre style URLs. Defaults use OpenFreeMap (street) + Esri World Imagery (satellite).
NEXT_PUBLIC_MAP_STREET_STYLE=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_SATELLITE_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# Google Maps *Embed* API key (designed to be public; restrict by HTTP referrer) for Street View
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
